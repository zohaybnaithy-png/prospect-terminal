# Optional for the demo UI. Required only for database commands.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prospect_terminal

# Optional, explicit ingestion write target. Not read by the UI.
# Apply migrations to this same development database before --apply.
INGESTION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prospect_ingestion_dev
# Integration tests require a fresh disposable database with exactly this name.
INGESTION_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prospect_ingestion_test

# Optional compatible HTTPS API base; defaults to the official Stats API.
# MLB_STATS_API_BASE_URL=https://statsapi.mlb.com/api/v1/
# Separate disposable database for live-shaped offline integration tests.
MLB_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prospect_mlb_test
