{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh auth status)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(vercel whoami)",
      "Bash(vercel inspect *)",
      "Bash(vercel logs *)",
      "Bash(vercel ls *)",
      "Bash(npm run verify:preview *)",
      "Bash(npm run -s verify:preview *)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run build)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr merge)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh api --method DELETE *)",
      "Bash(vercel --prod *)",
      "Bash(vercel --prod)",
      "Bash(vercel deploy --prod *)",
      "Bash(vercel promote *)",
      "Bash(vercel rollback *)",
      "Bash(vercel env *)",
      "Bash(vercel remove *)",
      "Bash(vercel rm *)",
      "Bash(vercel domains *)",
      "Bash(vercel alias *)",
      "Bash(vercel project rm *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin main *)",
      "Bash(git push origin main)",
      "Bash(git push origin staging *)",
      "Bash(git push origin staging)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git push origin HEAD:staging *)",
      "Bash(gh api *merge*)",
      "Bash(gh api *PUT*)",
      "Bash(gh api *PATCH*)",
      "Bash(gh api *POST*)",
      "Bash(gh api *DELETE*)",
      "Bash(gh api * -f *)",
      "Bash(gh api * -F *)",
      "Bash(gh api * --field *)",
      "Bash(gh api * --raw-field *)",
      "Bash(gh api * --input *)",
      "Bash(gh pr review *)",
      "Bash(git push *:main*)",
      "Bash(git push *:staging*)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(git push *:refs/heads/staging*)",
      "Bash(git push * main)",
      "Bash(git push * staging)",
      "Bash(git push * +*)",
      "Bash(git push --mirror *)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push * -d *)",
      "Bash(rm *prospect-terminal-dev-loop/merge-halt*)",
      "Bash(rm *prospect-terminal-dev-loop/merges.log*)"
    ]
  }
}
