{
  "name": "prospect-terminal",
  "version": "0.1.0",
  "description": "Player-first baseball prospect analytics: real AFL data, Momentum, scouting-style player profiles",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "build:vercel": "npm run -s snapshot:export && next build",
    "snapshot:export": "node --import tsx scripts/export-snapshot.ts",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test --test-timeout=60000 scripts/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --import tsx scripts/seed.ts",
    "ingest:afl": "node --import tsx scripts/ingest-afl.ts",
    "ingest:probe:afl": "node --use-env-proxy --import tsx scripts/probe-afl-source.ts",
    "ingest:milb": "node --import tsx scripts/ingest-milb.ts",
    "backfill:milb": "node --import tsx scripts/ops/milb-backfill.ts",
    "refresh:data": "node --import tsx scripts/refresh-data.ts",
    "check:freshness": "node --import tsx scripts/check-freshness.ts",
    "test:refresh:db": "node --import tsx --test scripts/refresh-db.integration.ts",
    "test:refresh:freshness:db": "node --import tsx --test scripts/refresh-freshness-db.integration.ts",
    "check:milb:readiness": "node --import tsx scripts/ops/milb-readiness.ts",
    "monitor": "node --import tsx scripts/ops/monitor.ts",
    "traffic:load": "node --import tsx scripts/ops/traffic-load.ts",
    "a11y:scan": "node --import tsx scripts/ops/a11y-scan.ts",
    "profile:site": "node --import tsx scripts/ops/site-profile.ts",
    "analytics:compare": "node --import tsx scripts/analytics-compare.ts",
    "test:ingestion:db": "node --import tsx --test scripts/ingestion-db.integration.ts",
    "test:mlb:db": "node --import tsx --test scripts/mlb-db.integration.ts",
    "test:afl:db": "node --import tsx --test scripts/afl-read.integration.ts",
    "test:roles:db": "node --import tsx --test scripts/db-roles.integration.ts",
    "check:db-roles": "node --import tsx scripts/ops/check-db-roles.ts",
    "test:milb:db": "node --import tsx --test scripts/milb-db.integration.ts",
    "test:snapshot:db": "node --import tsx --test scripts/snapshot-db.integration.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zohaybnaithy-png/prospect-terminal.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/zohaybnaithy-png/prospect-terminal/issues"
  },
  "homepage": "https://github.com/zohaybnaithy-png/prospect-terminal#readme",
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  }
}
