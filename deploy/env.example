# Template for /etc/prospect-terminal/env on the server (owner root, mode 600).
# Fill in the real value on the server only: never commit, paste into chat, or print it.
#
# Read-only role (deploy/neon-readonly-role.sql) on the PRODUCTION branch, pooled endpoint.
# Copy the connection string from Neon (Connect -> role pt_web -> "Pooled connection") and keep
# sslmode=require (pg verifies the certificate) and channel_binding=require.
DATABASE_URL=postgresql://pt_web:REPLACE_WITH_PASSWORD@ep-REPLACE-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Public origin for canonical URLs, robots.txt and sitemap.xml (scheme + host only, no path).
PT_SITE_URL=https://prospectterminal.example

# Rate limiting (docs/TRAFFIC.md): the ONE header Caddy overwrites with the client's address
# (deploy/Caddyfile: header_up X-PT-Client-IP {remote_host}). Must match. Unset or invalid in
# production: /health answers 503 "misconfigured" and the deploy rolls back. Never set it to
# X-Forwarded-For or another client-controlled header (refused). Emergency switch: PT_RATE_LIMIT=off.
PT_CLIENT_IP_HEADER=x-pt-client-ip

# STAGING ONLY (docs/STAGING-SERVER.md): never let search engines index this deployment. robots.txt
# disallows everything, the sitemap is empty, every response says noindex. Leave unset in production.
# PT_INDEXING=off

# Optional local monitor (docs/OBSERVABILITY.md; prospect-terminal-monitor.timer, disabled by
# default): an https dead-man's-switch URL pinged every run, `<url>/fail` on an alert.
# PT_MONITOR_PING_URL=https://hc-ping.com/REPLACE

# Optional: log every level load's timing breakdown (credential-free). Slow/failed loads are
# always logged.
# PT_DATA_TIMING=1

# Never set in production: ANALYTICS_DEBUG (exposes development model-comparison pages),
# INGESTION_DATABASE_URL (the web server never writes).
