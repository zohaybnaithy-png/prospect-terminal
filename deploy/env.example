# Template for /etc/prospect-terminal/env on the server (owner root, mode 600).
# Fill in the real value on the server only: never commit, paste into chat, or print it.
#
# Read-only role (deploy/neon-readonly-role.sql) on the PRODUCTION branch, pooled endpoint.
# Copy the connection string from Neon (Connect -> role pt_web -> "Pooled connection") and keep
# sslmode=require (pg verifies the certificate) and channel_binding=require.
DATABASE_URL=postgresql://pt_web:REPLACE_WITH_PASSWORD@ep-REPLACE-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Optional: log every level load's timing breakdown (credential-free). Slow/failed loads are
# always logged.
# PT_DATA_TIMING=1

# Never set in production: ANALYTICS_DEBUG (exposes development model-comparison pages),
# INGESTION_DATABASE_URL (the web server never writes).
